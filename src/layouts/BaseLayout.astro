---
import '../index.css';

export interface Props {
  title: string;
  description: string;
  /** Imagem para a prévia do link em WhatsApp, LinkedIn, X. */
  image?: string;
  /** 'website' para o catálogo, 'article' para um artigo. */
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  tags?: string[];
  /** JSON-LD já serializado, injetado no <head>. */
  jsonLd?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  author,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props;

// O build gera arquivos (`/artigo/slug.html`), mas a URL pública é limpa —
// é a Vercel que resolve uma na outra. O canonical precisa ser a URL pública,
// senão o Google indexa um endereço com `.html` que ninguém compartilha.
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/(.+)\/$/, '$1');

const canonical = new URL(cleanPath || '/', Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const siteName = 'AETHER Journal';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0c" />

    <!-- Open Graph: é isto que o WhatsApp, o LinkedIn e o Slack leem. -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="675" />}
    {ogImage && <meta property="og:image:alt" content={title} />}

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && author && <meta property="article:author" content={author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="sitemap" href="/sitemap-index.xml" />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    <!-- O tema escolhido pelo leitor é aplicado antes da primeira pintura,
         senão a cada navegação a página pisca no tema errado. -->
    <script is:inline>
      try {
        if (localStorage.getItem('aether_theme') === 'cyber-amber') {
          document.documentElement.dataset.theme = 'cyber-amber';
        }
      } catch (e) {
        /* modo privado sem storage: segue no tema padrão */
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
