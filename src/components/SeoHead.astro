---
/**
 * Cabeçalho de SEO — compartilhado por todos os temas.
 *
 * Open Graph, Twitter Card, canonical e JSON-LD são contrato com buscadores e
 * com quem cola o link no WhatsApp. Não são design. Se cada tema levasse a
 * própria cópia destas ~40 linhas, um ajuste de OG passaria a ter N lugares
 * para acertar — que é exatamente a duplicação que a separação por camadas
 * existe para impedir.
 *
 * O tema compõe este componente dentro do seu <head> e acrescenta o que é
 * dele: fonte, cor da barra do navegador, favicon.
 */
export interface Props {
  title: string;
  description: string;
  /** Imagem para a prévia do link em WhatsApp, LinkedIn, X. */
  image?: string;
  /** 'website' para o catálogo, 'article' para um artigo. */
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  tags?: string[];
  /** JSON-LD já serializado. */
  jsonLd?: string;
  noindex?: boolean;
  /** Nome da publicação, para `og:site_name`. */
  siteName: string;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  author,
  tags = [],
  jsonLd,
  noindex = false,
  siteName,
} = Astro.props;

// O build gera arquivos (`/artigo/slug/index.html`), mas a URL pública é limpa
// — é a Vercel que resolve uma na outra. O canonical precisa ser a URL pública,
// senão o Google indexa um endereço que ninguém compartilha.
const cleanPath = Astro.url.pathname
  .replace(/\/index\.html$/, '/')
  .replace(/\.html$/, '')
  .replace(/(.+)\/$/, '$1');

const canonical = new URL(cleanPath || '/', Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph: é isto que o WhatsApp, o LinkedIn e o Slack leem. -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && <meta property="og:image:width" content="1200" />}
{ogImage && <meta property="og:image:height" content="675" />}
{ogImage && <meta property="og:image:alt" content={title} />}

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<link rel="sitemap" href="/sitemap-index.xml" />

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
