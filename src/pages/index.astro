---
/**
 * Rota da home. Busca o dado, monta o JSON-LD e entrega ao tema ativo.
 *
 * Nada de aparência aqui: `@theme` é resolvido em tempo de build a partir de
 * BLOG_THEME (ver astro.config.mjs), então trocar de tema não toca nesta rota.
 */
import Home from '@theme/Home.astro';
import { fetchPublishedArticles, toSummary } from '../lib/posts';
import { getSiteConfig } from '../lib/site';

// Roda no build. Se o Supabase falhar aqui, o build falha e a Vercel mantém
// a versão anterior no ar — ver `lib/posts.ts`.
const site = await getSiteConfig();
const articles = await fetchPublishedArticles();
const summaries = articles.map(toSummary);

const description = site.description;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: site.name,
  description,
  url: Astro.site?.href,
  inLanguage: 'pt-BR',
  blogPost: articles.slice(0, 20).map((a) => ({
    '@type': 'BlogPosting',
    headline: a.title,
    url: new URL(`/artigo/${a.slug}`, Astro.site).href,
    datePublished: a.publishedAtIso,
    author: { '@type': 'Person', name: a.author.name },
  })),
});
---

<Home
  site={site}
  articles={articles}
  summaries={summaries}
  description={description}
  jsonLd={jsonLd}
/>
